# Mindfield — environment configuration
# Copy to .env and edit for your setup.
# cp .env.example .env

# ── Paths ────────────────────────────────────────────────────────────────────
LANCE_DB_PATH=./lancedb              # where your memory field lives

# ── Ports ────────────────────────────────────────────────────────────────────
LEAN_PORT=8018                       # lean memory API
VOYAGER_PORT=8008                    # web frontend
EMBED_PORT=8082                      # nomic-embed-text

# ── Inference (pick one GGUF, or leave blank for fragment-only mode) ─────────
# GGUF_MODEL_PATH=./models/your-model.gguf
# GGUF_PORT=8009
# GGUF_GPU_LAYERS=99                 # 0 = CPU only, 99 = all layers to GPU

# ── Embedding ────────────────────────────────────────────────────────────────
EMBED_URL=http://127.0.0.1:8082
EMBED_GPU_LAYERS=0                   # nomic runs fine on CPU

# Embedding model — change both if you swap models
# Default: nomic-embed-text-v1.5 (768-dim). Other options:
#   mxbai-embed-large-v1 → EMBED_DIM=1024
#   all-MiniLM-L6-v2     → EMBED_DIM=384
# WARNING: changing DIM on an existing LanceDB requires a full re-ingest.
EMBED_MODEL=nomic-embed-text-v1.5
EMBED_DIM=768

# ── Optional: Bifrost Claude API path ────────────────────────────────────────
# Only needed if you want the Claude API fallback path in Bifrost.
# Keep this out of git — use .env only.
# ANTHROPIC_API_KEY=sk-ant-...
